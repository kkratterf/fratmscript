// ============================================
// Example 4: Loops
// mentre che (while), primm fa (do...while), pe (for), pe ogni … dint / 'ncopp (for...of / for...in), ++ and +=
// ============================================

// While loop - mentre che
stamm a dì("=== Neapolitan Countdown ===")
tien countdown = 5
mentre che (countdown > 0) {
    stamm a dì(countdown + "...")
    countdown--
}
stamm a dì("🎆 Happy New Year!")

// Do...while - primm fa { } mentre che (…): the body runs at least once
stamm a dì("\n=== Coffee refills (do...while) ===")
tien tazzine = 0
primm fa {
    tazzine++
    stamm a dì("☕ Tazzina " + tazzine)
} mentre che (tazzine < 2)

// For loop - pe (ogni is optional)
stamm a dì("\n=== Multiplication Table of 7 ===")
pe (tien i = 1; i <= 10; i++) {
    stamm a dì("7 x " + i + " = " + (7 * i))
}

// For...of - pe ogni (… dint …)
stamm a dì("\n=== Pizza menu (for...of) ===")
chist è pizze = ["Margherita", "Marinara", "Diavola"]
pe ogni (chist è pizza dint pizze) {
    stamm a dì("🍕 " + pizza)
}

// For...in - pe ogni (… 'ncopp …)
stamm a dì("\n=== Prices (for...in) ===")
chist è prezzi = { margherita: 5, marinara: 4 }
pe ogni (tien nome 'ncopp prezzi) {
    stamm a dì(nome + ": " + prezzi[nome] + "€")
}

// Break - rompe
stamm a dì("\n=== Find the number (break) ===")
pe (tien n = 1; n <= 100; n++) {
    si (n == 42) {
        stamm a dì("Found it! The number is " + n)
        rompe
    }
}

// Continue - salta
stamm a dì("\n=== Odd numbers (continue) ===")
pe (tien j = 1; j <= 10; j++) {
    si (j % 2 == 0) {
        salta // Skip even numbers
    }
    stamm a dì(j)
}

// Nested loops
stamm a dì("\n=== Pattern (nested loops) ===")
pe (tien riga = 1; riga <= 5; riga++) {
    tien stelle = ""
    pe (tien col = 1; col <= riga; col++) {
        stelle += "⭐"
    }
    stamm a dì(stelle)
}

// Fibonacci with while
stamm a dì("\n=== Fibonacci ===")
tien fib1 = 0
tien fib2 = 1
tien fibCount = 0
mentre che (fibCount < 10) {
    stamm a dì(fib1)
    tien temp = fib1 + fib2
    fib1 = fib2
    fib2 = temp
    fibCount = fibCount + 1
}
