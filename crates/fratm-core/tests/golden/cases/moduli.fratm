// Every export form
chist è x = 1
tien comme = 2
mann for { x, comme comme y, x comme predefinit }
mann for { c, d comme e } da "./c.js"
mann for * da "./d.js"
mann for * comme spazio da "./e.js"

// Dynamic import
mo vir facc carica(nome) {
    chist è modulo = aspett chiamm("./pagine/" + nome + ".js")
    piglie modulo.default
}
