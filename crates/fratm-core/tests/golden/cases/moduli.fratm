// Every import form
chiamm React da "react"
chiamm Vue, { ref, computed comme calcola } da "vue"
chiamm * comme fs da "node:fs"
chiamm Pippo, * comme tutto da "./pippo.js"
chiamm { predefinit comme Base, for } da "./base.js"
chiamm {
    a,
    b as bi,
} da "./multi.js"
