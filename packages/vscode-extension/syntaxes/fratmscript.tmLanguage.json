{
  "name": "FratmScript",
  "scopeName": "source.fratm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template-strings" },
    { "include": "#jsx" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#private" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fratm",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fratm",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "comment.block.fratm",
              "match": "."
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fratm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fratm",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.fratm",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.fratm",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "template-strings": {
      "patterns": [
        { "include": "#stile-template" },
        { "include": "#gomorra-template" },
        {
          "name": "string.template.fratm",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.fratm",
              "match": "\\\\."
            },
            { "include": "#template-hole" }
          ]
        }
      ]
    },
    "template-hole": {
      "name": "meta.template.expression.fratm",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.fratm"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.fratm"
        }
      },
      "patterns": [
        {
          "include": "source.fratm"
        }
      ]
    },
    "stile-template": {
      "comment": "stile`…`: CSS in Neapolitan, kept in sync with crates/fratm-core/src/stile.rs by its tests",
      "name": "string.template.stile.fratm",
      "begin": "\\b(stile)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.fratm"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.fratm"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.fratm"
        }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [
        {
          "name": "constant.character.escape.fratm",
          "match": "\\\\."
        },
        {
          "include": "#template-hole"
        },
        {
          "name": "comment.block.css",
          "begin": "/\\*",
          "end": "\\*/|(?=`)"
        },
        {
          "name": "keyword.control.at-rule.css",
          "match": "@[\\p{L}_-][\\p{L}\\p{N}_-]*"
        },
        {
          "name": "string.quoted.css",
          "match": "\"[^\"`]*\"|'[^'`]*'"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_$-])(-{0,2}[\\p{L}_][\\p{L}\\p{N}_-]*)\\s*(:)(?=\\s|$)",
          "captures": {
            "1": {
              "name": "support.type.property-name.css"
            },
            "2": {
              "name": "punctuation.separator.key-value.css"
            }
          }
        },
        {
          "name": "entity.other.attribute-name.pseudo-class.css",
          "match": "::?[\\p{L}_-][\\p{L}\\p{N}_-]*"
        },
        {
          "name": "entity.name.tag.css",
          "match": "(?<![\\p{L}\\p{N}_$-])(?:abbreviazione|cuorpotavula|luccolicchio|ragionamento|sottolineato|suggerimenti|avanzamento|capocasella|definizione|evidenziato|fattariello|luccoliello|significato|vocabolario|blockquote|cancellato|capotavula|chiacchier|didascalia|fenestella|figcaption|luccolillo|peretavula|senzafratm|virgulette|citazione|culunnato|etichetta|incognita|indirizzo|luccolata|luccolino|luccolone|parentesi|piccirill|pronuncia|risultato|scatulell|schermata|aggiunto|allevers|anteprim|cappiell|cartello|cartulin|citofono|colgroup|cristian|datalist|fieldset|forsacap|leggenda|noscript|optgroup|progress|tastiera|template|textarea|accussi|accussì|address|article|attacca|caption|cascett|casella|cornice|corsivo|culonna|details|dialogo|disegno|fessura|filmato|funtana|inciucc|isolato|listino|luccolo|ncastro|opzione|picture|recinto|section|spoiler|stuorto|summary|tavulat|traccia|vattenn|allato|button|canvas|codice|dialog|elenco|figure|footer|glossa|gruppo|header|hgroup|iframe|legend|levato|misura|modulo|ncoppa|object|option|output|parola|quadro|scegli|script|search|select|source|stampo|strong|tiempo|titolo|tomtom|aside|audio|cerca|cunte|embed|fonte|fratm|guapp|input|label|mappa|meter|miett|ogget|piezz|small|sotto|stacc|style|suono|table|tbody|tfoot|thead|title|track|video|abbr|acap|area|basa|base|body|capa|cess|cite|code|core|data|dato|fila|form|fort|head|html|link|list|main|mark|math|menu|meta|panz|pere|ruby|samp|slot|span|tela|time|voce|zona|bdi|bdo|col|del|dfn|div|img|ins|kbd|map|nav|pre|sub|sup|svg|var|wbr|br|dd|dl|dt|em|h1|h2|h3|h4|h5|h6|hr|li|ol|rp|rt|td|th|tr|ul|a|b|i|p|q|s|u)(?![\\p{L}\\p{N}_$-])(?=\\s*(?:[{,>+~\\[]|[.#][\\p{L}_-]|::?[\\p{L}])|\\s+[^:;`]*\\{)"
        },
        {
          "name": "constant.other.color.rgb-value.css",
          "match": "#\\h{3,8}(?![\\p{L}\\p{N}_$-])"
        },
        {
          "name": "entity.other.attribute-name.id.css",
          "match": "#[\\p{L}_-][\\p{L}\\p{N}_-]*"
        },
        {
          "name": "constant.numeric.css",
          "match": "(?<![\\p{L}\\p{N}_$-])-?(?:\\d+\\.?\\d*|\\.\\d+)(?:[a-zA-Z]+|%)?"
        },
        {
          "name": "entity.other.attribute-name.class.css",
          "match": "\\.[\\p{L}_-][\\p{L}\\p{N}_-]*"
        },
        {
          "name": "support.constant.property-value.css",
          "match": "(?<![\\p{L}\\p{N}_$-])(?:culore-corrente|blocco-in-linea|bordo-incluso|nun-va-a-capo|sottolineato|tratteggiato|stiracchiato|trasparente|appiccecata|appiccecato|nun-ripete|automatico|flessibile|puntinato|alternato|minuscolo|grassetto|arancione|ereditato|maiuscolo|relativo|relativa|iniziale|visibile|spartuto|assoluta|attuorno|in-linea|contiene|infinito|nisciuno|assoluto|nascosto|continuo|argiento|sbarrato|corsivo|griglia|azzurro|colonna|lineare|manella|aspetta|marrone|normale|celeste|statico|destra|niente|ripete|grigio|mmiezo|ncoppa|a-capo|scorre|facile|giallo|blocco|inizio|janco|copre|fisso|viola|miezo|manca|fissa|verde|russo|sotto|riga|niro|fine|nero|rosa|blu|oro)(?![\\p{L}\\p{N}_$-])"
        },
        {
          "name": "support.function.css",
          "match": "(?<![\\p{L}\\p{N}_$-])[\\p{L}_-][\\p{L}\\p{N}_-]*(?=\\()"
        },
        {
          "name": "punctuation.section.property-list.css",
          "match": "[{}]"
        },
        {
          "name": "punctuation.terminator.rule.css",
          "match": ";"
        }
      ]
    },
    "gomorra-template": {
      "comment": "gomorra`…`: GomorraSQL, kept in sync with crates/fratm-core/src/gomorra.rs by its tests",
      "name": "string.template.gomorra.fratm",
      "begin": "\\b(gomorra)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tagged-template.fratm"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.fratm"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.fratm"
        }
      },
      "contentName": "meta.embedded.block.sql",
      "patterns": [
        {
          "name": "constant.character.escape.fratm",
          "match": "\\\\."
        },
        {
          "include": "#template-hole"
        },
        {
          "name": "comment.line.double-dash.sql",
          "match": "--(?:[^`$]|\\$(?!\\{))*"
        },
        {
          "name": "string.quoted.double.sql",
          "match": "\"[^\"`]*\""
        },
        {
          "name": "keyword.other.DML.sql",
          "match": "(?<![\\p{L}\\p{N}_$-])(?:abbrucimm\\s+'a\\s+tavula|facimm\\s+na'\\s+strage|facimm\\s+'a\\s+tavula|iamme\\s+bello\\s+ia'|nzipp\\s+'ngoppa|ua\\s+uagliò|ripigliammo|rifacimm|sfaccimm)(?![\\p{L}\\p{N}_$-])"
        },
        {
          "name": "keyword.other.sql",
          "match": "(?<![\\p{L}\\p{N}_$-])(?:facimm\\s+'e\\s+mucchie\\s+pe|mettimmo\\s+in\\s+fila\\s+pe|nun\\s+cchiù\\s+'e|pesc\\s+e\\s+pesc|mmiez\\s+'a|zumpanno|accunza|chist|arò)(?![\\p{L}\\p{N}_$-])"
        },
        {
          "name": "keyword.operator.sql",
          "match": "(?<![\\p{L}\\p{N}_$-])(?:nun\\s+assumiglia\\s+a|assumiglia\\s+a|nun\\s+dint'a|nun\\s+è|accussì|dint'a|comme|nun|e|o|è)(?![\\p{L}\\p{N}_$-])"
        },
        {
          "name": "constant.language.sql",
          "match": "(?<![\\p{L}\\p{N}_$-])(?:tutto\\s+chillo\\s+ch'era\\s+'o\\s+nuostro|nun\\s+è\\s+nisciun|a\\s+scennere|è\\s+nisciun|a\\s+salì|nisciun|overo|sfòls)(?![\\p{L}\\p{N}_$-])"
        },
        {
          "name": "keyword.other.sql",
          "match": "(?i)\\b(?:select|from|where|insert|into|update|set|delete|create|table|drop|if|exists|join|left|inner|on|order|group|by|limit|offset|values|and|or|not|null|as|like|in|is|asc|desc|begin|commit|rollback|primary|key|integer|text|real|default)\\b"
        },
        {
          "name": "constant.numeric.sql",
          "match": "(?<![\\p{L}\\p{N}_$-])\\d+(?:\\.\\d+)?"
        },
        {
          "name": "keyword.operator.comparison.sql",
          "match": "<=|>=|<>|!=|=|<|>"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fratm",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.fratm",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.fratm",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.fratm",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "Control flow: si (if), sinnò (else), mentre che (while), pe ogni (for), rompe (break), salta (continue)",
          "name": "keyword.control.fratm",
          "match": "\\b(si|sinnò|sinno|mentre|che|pe|ogni|dint|vedimm|predefinit|primm fa|rompe|salta|piglie|pruvamm|schiatta|aropp|iett|vir|caso)\\b"
        },
        {
          "comment": "Variable declarations: chist è (const), tien (let), facc (function)",
          "name": "storage.type.fratm",
          "match": "\\b(chist|è|tien|facc|mo|na|famiglie|fisso|damme|miette)\\b"
        },
        {
          "comment": "Class/OOP: nu bell (new), figlio 'e (extends), 'o pate (super), costruttore",
          "name": "keyword.other.fratm",
          "match": "\\b(nu|bell|figlio|costruttore)\\b"
        },
        {
          "comment": "Special keywords with apostrophe",
          "name": "keyword.other.fratm",
          "match": "'(e|o pate|ncopp)\\b"
        },
        {
          "comment": "Module: chiamm (import), da (from), mann for (export), comme (as)",
          "name": "keyword.control.import.fratm",
          "match": "\\b(chiamm|da|mann|for|predefinit|comme)\\b"
        },
        {
          "comment": "Async: mo vir (async), aspett (await)",
          "name": "keyword.control.async.fratm",
          "match": "\\b(aspett)\\b"
        },
        {
          "comment": "This: stu cos",
          "name": "variable.language.this.fratm",
          "match": "\\b(stu|cos)\\b"
        },
        {
          "comment": "Operators as keywords: leva (delete), caccia (yield), chè è (typeof), è uno (instanceof)",
          "name": "keyword.operator.expression.fratm",
          "match": "\\b(leva|caccia|fermete)\\b"
        },
        {
          "comment": "Special: dint'a (in)",
          "name": "keyword.operator.expression.fratm",
          "match": "dint'a\\b"
        },
        {
          "comment": "Console functions: stamm a dì (log), scrive (error), avvis (warn)",
          "name": "support.function.console.fratm",
          "match": "\\b(stamm|dì|di|scrive|avvis)\\b"
        },
        {
          "comment": "Type checks: chè è (typeof), è uno (instanceof)",
          "name": "keyword.operator.expression.fratm",
          "match": "\\b(chè|uno|typeof|instanceof)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "comment": "Boolean true: overo",
          "name": "constant.language.boolean.true.fratm",
          "match": "\\b(overo)\\b"
        },
        {
          "comment": "Boolean false: sfòls",
          "name": "constant.language.boolean.false.fratm",
          "match": "\\b(sfòls|sfols)\\b"
        },
        {
          "comment": "Null: nisciun",
          "name": "constant.language.null.fratm",
          "match": "\\b(nisciun)\\b"
        },
        {
          "comment": "Undefined: boh",
          "name": "constant.language.undefined.fratm",
          "match": "\\b(boh)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Logical operators: e (and), o (or), no (not), manco, pure",
          "name": "keyword.operator.logical.fratm",
          "match": "\\b(e|o|no|manco|pure)\\b"
        },
        {
          "comment": "Arrow function",
          "name": "storage.type.function.arrow.fratm",
          "match": "=>"
        },
        {
          "comment": "Compound assignment: ??=, ||=, &&=, **=",
          "name": "keyword.operator.assignment.compound.fratm",
          "match": "(\\?\\?=|\\|\\|=|&&=|\\*\\*=)"
        },
        {
          "comment": "Optional chaining",
          "name": "punctuation.accessor.optional.fratm",
          "match": "\\?\\."
        },
        {
          "comment": "Nullish coalescing and symbolic logic",
          "name": "keyword.operator.logical.fratm",
          "match": "(\\?\\?|&&|\\|\\||!(?!=))"
        },
        {
          "comment": "Increment and decrement",
          "name": "keyword.operator.increment.fratm",
          "match": "(\\+\\+|--)"
        },
        {
          "comment": "Bitwise operators and shifts",
          "name": "keyword.operator.bitwise.fratm",
          "match": "(>>>=?|>>=?|<<=?|&=|\\|=|\\^=|&|\\||\\^|~)"
        },
        {
          "comment": "Comparison operators",
          "name": "keyword.operator.comparison.fratm",
          "match": "(===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "comment": "Assignment operators",
          "name": "keyword.operator.assignment.fratm",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "comment": "Arithmetic operators",
          "name": "keyword.operator.arithmetic.fratm",
          "match": "(\\*\\*|\\+|-|\\*|/|%)"
        },
        {
          "comment": "Ternary operator",
          "name": "keyword.operator.ternary.fratm",
          "match": "[?:]"
        },
        {
          "comment": "Spread operator",
          "name": "keyword.operator.spread.fratm",
          "match": "\\.\\.\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function calls",
          "name": "entity.name.function.fratm",
          "match": "(?<![\\w$])([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*(?=\\()"
        },
        {
          "comment": "Method definitions after facc",
          "name": "entity.name.function.method.fratm",
          "match": "(?<=facc\\s+)([a-zA-Z_$][a-zA-Z0-9_$]*)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "comment": "Variable after chist",
          "name": "variable.other.constant.fratm",
          "match": "(?<=chist\\s+)([a-zA-Z_$][a-zA-Z0-9_$]*)"
        },
        {
          "comment": "Variable after tien",
          "name": "variable.other.readwrite.fratm",
          "match": "(?<=tien\\s+)([a-zA-Z_$][a-zA-Z0-9_$]*)"
        }
      ]
    },
    "private": {
      "patterns": [
        {
          "comment": "Private class members: #nomme",
          "name": "variable.other.private.fratm",
          "match": "#[\\p{L}_$][\\p{L}\\p{N}_$]*"
        }
      ]
    },
    "jsx": {
      "comment": "JSX element, only where an expression can start (after ( [ , = : ? { } & | ! ; => piglie or at the start of a line), so a < b stays a comparison",
      "patterns": [
        {
          "name": "meta.tag.jsx.fratm",
          "begin": "(?:^|(?<=[(\\[,=:?{}&|!;]|=>|\\bpiglie))\\s*(<)(?:([a-z][\\w\\-:]*)|([\\p{L}_$][\\w.$]*)|(?=>))(?=[\\s/>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.fratm" },
            "2": { "name": "entity.name.tag.fratm" },
            "3": { "name": "support.class.component.fratm" }
          },
          "end": "(/>)|(?:(</)(?:([a-z][\\w\\-:]*)|([\\p{L}_$][\\w.$]*))?\\s*(>))",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.fratm" },
            "2": { "name": "punctuation.definition.tag.begin.fratm" },
            "3": { "name": "entity.name.tag.fratm" },
            "4": { "name": "support.class.component.fratm" },
            "5": { "name": "punctuation.definition.tag.end.fratm" }
          },
          "patterns": [
            { "include": "#jsx-attributes" },
            { "include": "#jsx-children" }
          ]
        }
      ]
    },
    "jsx-element": {
      "comment": "JSX element nested in children or used as an attribute value",
      "patterns": [
        {
          "name": "meta.tag.jsx.fratm",
          "begin": "(<)(?:([a-z][\\w\\-:]*)|([\\p{L}_$][\\w.$]*)|(?=>))(?=[\\s/>])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.fratm" },
            "2": { "name": "entity.name.tag.fratm" },
            "3": { "name": "support.class.component.fratm" }
          },
          "end": "(/>)|(?:(</)(?:([a-z][\\w\\-:]*)|([\\p{L}_$][\\w.$]*))?\\s*(>))",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.fratm" },
            "2": { "name": "punctuation.definition.tag.begin.fratm" },
            "3": { "name": "entity.name.tag.fratm" },
            "4": { "name": "support.class.component.fratm" },
            "5": { "name": "punctuation.definition.tag.end.fratm" }
          },
          "patterns": [
            { "include": "#jsx-attributes" },
            { "include": "#jsx-children" }
          ]
        }
      ]
    },
    "jsx-attributes": {
      "comment": "Attribute names, values and spreads, until the > that starts the children",
      "patterns": [
        { "include": "#comments" },
        {
          "name": "entity.other.attribute-name.fratm",
          "match": "[\\p{L}_$][\\w\\-:$]*"
        },
        {
          "name": "keyword.operator.assignment.fratm",
          "match": "="
        },
        {
          "name": "string.quoted.double.fratm",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.fratm",
          "begin": "'",
          "end": "'"
        },
        { "include": "#jsx-expression" },
        { "include": "#jsx-element" }
      ]
    },
    "jsx-children": {
      "contentName": "meta.jsx.children.fratm",
      "begin": "(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.end.fratm" }
      },
      "end": "(?=</)",
      "patterns": [
        { "include": "#jsx-element" },
        { "include": "#jsx-expression" },
        {
          "name": "constant.character.entity.fratm",
          "match": "&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#x[0-9a-fA-F]+);"
        }
      ]
    },
    "jsx-expression": {
      "name": "meta.embedded.expression.fratm",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.fratm" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.fratm" }
      },
      "patterns": [
        { "include": "#braces" },
        { "include": "source.fratm" }
      ]
    },
    "braces": {
      "comment": "Balanced { } inside a JSX expression, so an object literal does not close it",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#braces" },
        { "include": "source.fratm" }
      ]
    }
  }
}
